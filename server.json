{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pinnfeed/pinnfeed-mcp",
  "title": "PinnFeed",
  "description": "Live and prematch Pinnacle odds, no-vig fair prices, price drops and closing lines.",
  "version": "1.0.0",
  "websiteUrl": "https://pinnfeed.io/docs/mcp",
  "repository": { "url": "https://github.com/pinnfeed/pinnfeed-mcp", "source": "github" },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://pinnfeed.io/mcp",
      "headers": [
        { "name": "Authorization", "description": "Bearer YOUR_PINNFEED_API_KEY", "isRequired": true, "isSecret": true }
      ]
    }
  ]
}
